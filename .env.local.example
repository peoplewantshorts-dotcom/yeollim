# 이 파일을 .env.local 로 복사하고 키를 채워 넣으세요.
# .env.local 은 git 에 올라가지 않습니다.

# ── 구글 ──────────────────────────────────────
GOOGLE_TTS_KEY=여기에_키를_붙여넣으세요

# 목소리 (안 적으면 ko-KR-Chirp3-HD-Leda)
# 무료 한도가 확실한 것: ko-KR-Wavenet-A, ko-KR-Neural2-A
# 소리가 제일 좋은 것: ko-KR-Chirp3-HD-Leda
TTS_VOICE=ko-KR-Chirp3-HD-Leda

# ── 네이버 클로바를 쓸 경우 ────────────────────
# CLOVA_ID=
# CLOVA_SECRET=
